{
  "name": "@quidli/connect-mcp",
  "version": "0.5.3",
  "description": "Identity and reputation for AI agents: resolve social handles to wallet addresses, check reputation scores, and send tokens from any MCP client.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai",
    "agent",
    "web3-agent",
    "agent-payments",
    "identity",
    "identity-resolution",
    "reputation",
    "payments",
    "wallet",
    "usdc",
    "farcaster",
    "x402"
  ],
  "homepage": "https://quidli.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quidli/connect-mcp.git"
  },
  "author": {
    "name": "Quidli",
    "url": "https://quidli.xyz"
  },
  "type": "module",
  "bin": {
    "connect-mcp": "dist/index.js",
    "connect-mcp-http": "dist/index-http.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./mount": "./dist/mount.js",
    "./http": "./dist/http.js"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && chmod +x dist/index.js dist/index-http.js",
    "start": "node dist/index.js",
    "start:http": "node dist/index-http.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@x402/evm": "~2.5.0",
    "@x402/fetch": "~2.5.0",
    "express": "^5.2.1",
    "viem": "^2.50.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.justinquidli/connect-mcp",
  "bugs": {
    "url": "https://github.com/Quidli/connect-mcp/issues"
  }
}
