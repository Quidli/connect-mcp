{
  "name": "@quidli/connect-mcp",
  "version": "0.6.10",
  "description": "Wallet lookup, onchain reputation and payments for multiplayer agents. Resolve any social handle - email, phone, X, Telegram, Discord, GitHub, LinkedIn, Farcaster and more - to an EVM or Solana wallet, score it from online social histories, and send agent payments in any ERC-20, SPL or native token. Includes creation of trust graphs on Base, built from EAS attestations.",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "reputation",
    "onchain-reputation",
    "identity",
    "identity-resolution",
    "wallet",
    "wallet-lookup",
    "agent",
    "ai",
    "agent-payments",
    "payments",
    "usdc",
    "crypto",
    "web3-agent",
    "multiplayer-agents",
    "x402",
    "ethereum",
    "solana",
    "base",
    "farcaster",
    "claude",
    "cursor",
    "claude-desktop"
  ],
  "homepage": "https://connect.quid.li",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Quidli/connect-mcp.git"
  },
  "author": {
    "name": "Quidli",
    "url": "https://quidli.xyz"
  },
  "type": "module",
  "bin": {
    "connect-mcp": "dist/index.js",
    "connect-mcp-http": "dist/index-http.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "!dist/**/*.test.js.map"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./mount": "./dist/mount.js",
    "./http": "./dist/http.js"
  },
  "scripts": {
    "build": "tsc && node --input-type=commonjs -e \"const fs=require('fs'); for (const f of ['dist/index.js','dist/index-http.js']) fs.chmodSync(f, 0o755)\"",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "start:http": "node dist/index-http.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@x402/evm": "~2.5.0",
    "@x402/fetch": "~2.5.0",
    "express": "^5.2.1",
    "viem": "^2.50.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.Quidli/connect-mcp",
  "bugs": {
    "url": "https://github.com/Quidli/connect-mcp/issues"
  }
}
